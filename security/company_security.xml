<?xml version="1.0" encoding="utf-8"?>

<odoo>
     <record model="ir.module.category" id="company_security">
        <field name="name">سطوح دسترسی سامانه کمپانی</field>
    </record>

    <record id="group_company_modir_mali" model="res.groups">
        <field name="name">مدیر مالی</field>
        <field name="category_id" ref="company_security"/>
    </record>

     <record id="group_company_karmand" model="res.groups">
        <field name="name">کارمند</field>
        <field name="category_id" ref="company_security"/>
    </record>

        <record id="rule_company_request_karmand_only" model="ir.rule">
            <field name="name">Employee can only see their own requests</field>
            <field name="model_id" ref="model_company_request"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_company_karmand'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>


        <record id="rule_company_request_modir_mali_all" model="ir.rule">
            <field name="name">Manager can see all requests</field>
            <field name="model_id" ref="model_company_request"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_company_modir_mali'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>
</odoo>