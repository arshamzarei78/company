<odoo>

    <record id="action_report_order" model="ir.actions.report">


        <field name="name">Order Report</field>
        <field name="model">resturant.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">resturant.order_report</field>
        <field name="report_file">resturant.order_report</field>
        <field name="binding_model_id" ref="model_resturant_order"/>
        <field name="binding_type">report</field>
    </record>
    <template id="order_report">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="order">
                    <t t-call="web.external_layout">

                        <div class="page">

                            <h2>فاکتور سفارش</h2>

                            <p>
                                نام مشتری:
                                <span t-field="order.karmand_id"/>
                            </p>

                            <p>
                                تاریخ:
                                <span t-field="order.date"/>
                            </p>

                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>تنخا</th>
                                        <th>تعداد</th>
                                        <th>مجموع</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    <tr t-foreach="order.order_line_ids" t-as="line">
                                        <td>
                                            <span t-field="line.tankha_id"/>
                                        </td>
                                        <td>
                                            <span t-field="line.quantity"/>
                                        </td>
                                        <td>
                                            <span t-field="line.total"/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>

                            <h3>
                                مجموع کل تنخا:
                                <span t-field="order.total_amount"/>
                            </h3>

                        </div>

                    </t>
                </t>
            </t>
        </template>
</odoo>