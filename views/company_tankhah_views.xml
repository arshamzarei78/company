<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>
        <record id="action_company_tankhah" model="ir.actions.act_window">
            <field name="name">تنحواه</field>
            <field name="res_model">company.tankhah</field>
            <field name="view_mode">tree,form</field>
        </record>

        <record id="view_company_tankhah_form" model="ir.ui.view">
            <field name="name">company.tankhah.form</field>
            <field name="model">company.tankhah</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="price"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="مشخصات">
                                <group>
                                </group>
                            </page>

                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_company_tankhah_tree" model="ir.ui.view">
            <field name="name">company.tankhah.tree</field>
            <field name="model">company.tankhah</field>
            <field name="arch" type="xml">
                <tree default_order="id desc">
                    <field name="name"/>
                    <field name="price"/>
                </tree>
            </field>
        </record>

        <record id="view_company_tankhah_search" model="ir.ui.view">
            <field name="name">company.tankhah.search</field>
            <field name="model">company.tankhah</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                </search>
            </field>
        </record>
    </data>

</odoo>