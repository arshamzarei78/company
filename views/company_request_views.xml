<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="action_company_request" model="ir.actions.act_window">
            <field name="name">سفارش</field>
            <field name="res_model">company.request</field>
            <field name="view_mode">tree,form</field>
        </record>



        <record id="view_company_request_form" model="ir.ui.view">
            <field name="model">company.request</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="total_amount"/>
                            <field name="karmand_id"/>
                            <field name="description"/>
                            <field name="request_line_ids">
                            <tree editable="bottom">
                                <field name="tankhah_id"/>
                                <field name="quantity"/>
                                <field name="total"/>
                            </tree>
                            </field>
                                                        <!-- مشتری: فقط مشاهده -->
                            <field name="status"
                                   groups="company.group_company_karmand"
                                   readonly="1"/>

                            <!-- سرآشپز: قابل تغییر -->
                            <field name="status"
                                   groups="company.group_company_modir_mali"/>
                        </group>

                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_company_request_list" model="ir.ui.view">
            <field name="name">company.request.list</field>
            <field name="model">company.request</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="karmand_id"/>
                    <field name="description"/>
                    <field name="status"/>
                </tree>
            </field>
        </record>


    </data>
</odoo>
