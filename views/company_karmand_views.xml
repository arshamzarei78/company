<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <data>
        <record id="action_company_karmand" model="ir.actions.act_window">
            <field name="name">پیشنهاد</field>
            <field name="res_model">estate.property.offer</field>
            <field name="view_mode">tree,form</field>
        </record>

        <record id="view_company_karmand_tree" model="ir.ui.view">
            <field name="model">company.karmand</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="code"/>
                    <field name="gender"/>
                    <field name="description"/>
                </tree>
            </field>
        </record>

        <record id="view_company_karmand_form" model="ir.ui.view">
            <field name="model">company.karmand</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="description"/>
                            <field name="gender"/>
                            <field name="birth_date"/>
                            <field name="phone"/>
                            <field name="address"/>
                            <field name="is_active"/>
                        </group>
                    </sheet>
                </form>
            </field>











    </data>
</odoo>